# ============================================================
# AutoWorldModel-Bench: Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# --- Claude Code Agent (pick ONE auth mode) ---

# Option A: Anthropic API (or compatible gateway)
ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_BASE_URL=                   # Optional: custom gateway URL (omit for default api.anthropic.com)

# Option B: AWS Bedrock (pass --bedrock flag to run_harbor.sh / orchestrate.py)
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# --- Codex Agent ---
# Either OPENAI_API_KEY or AZURE_OPENAI_API_KEY (fallback)
OPENAI_API_KEY=sk-...
# AZURE_OPENAI_API_KEY=                 # Alternative: Azure OpenAI key (used if OPENAI_API_KEY not set)
# OPENAI_BASE_URL=                      # Optional: custom endpoint (e.g., Azure OpenAI URL)

# --- Gemini Agent ---
# GEMINI_API_KEY=...

# --- Data (HuggingFace) ---
HF_TOKEN=hf_...
